{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "cypress:open": "CYPRESS_BASE_URL=http://localhost:8080 cypress open",
    "cypress:run": "cypress run",
    "cypress:run:all": "pnpm cypress:run:component && pnpm cypress:run",
    "cypress:run:component": "cypress run --component --browser chrome",
    "cypress:run:e2e": "cypress run --browser chrome --headed --no-runner-ui",
    "dev": "next dev --webpack",
    "build": "next build --webpack && next-nginx-routes && node lib/generateVersionFile.mjs",
    "start": "next start",
    "lint": "eslint .",
    "codegen": "graphql-codegen",
    "format": "prettier --write .",
    "tsc": "tsc",
    "husky:setup": "cd .. && husky frontend/.husky",
    "updeps": "pnpm up --latest --interactive"
  },
  "dependencies": {
    "@camptocamp/ogc-client": "^2.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@sentry/cli": "^3.6.2",
    "@sentry/nextjs": "^11.9.0",
    "@tanstack/react-table": "^8.21.3",
    "dompurify": "^3.4.17",
    "graphql-request": "^5.2.0",
    "lodash": "^4.18.1",
    "next": "16.4.3",
    "ol": "^10.11.0",
    "ole": "link:packages/ole",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-spatial": "link:packages/react-spatial",
    "rosetta": "^1.1.0",
    "sharp": "^0.35.5",
    "shpjs": "^6.2.0",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@cypress/react": "^10.0.1",
    "@geops/eslint-config-react": "2.0.0-beta.6",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@parcel/watcher": "^2.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/shpjs": "^3.4.7",
    "cypress": "16.2.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next-nginx-routes": "^1.3.0",
    "pixelmatch": "^8.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.15.0"
}
